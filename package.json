{
  "name": "@web-ide/python-graphics",
  "version": "0.3.0-images.0",
  "description": "Reusable browser Python 2D graphics companion for the web-ide component: a retained scene model, a bounded byte-device protocol with a multiplexer, an SVG renderer, and an optional Web IDE plugin.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinvassantachart/web-ide-python-graphics.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "docs/INTEGRATION.md",
    "examples/starters"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run test:python && npm run build && npm run check:transport && npm run check:worker && npm run check:images",
    "check:consumer": "node consumer-check/run.mjs",
    "pack:check": "npm pack --dry-run",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "check:transport": "node scripts/check-neutral-transport.mjs",
    "check:worker": "node scripts/check-worker-core.mjs",
    "check:images": "node scripts/check-images.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "web-ide": ">=0.11.0-images.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.7",
    "vite-plugin-dts": "5.1.2",
    "vitest": "^4.1.12",
    "web-ide": "https://github.com/justinvassantachart/web-ide/releases/download/web-ide-v0.11.0-images.0/web-ide-0.11.0-images.0.tgz"
  },
  "keywords": [
    "web-ide",
    "python",
    "graphics",
    "education",
    "svg",
    "canvas"
  ]
}
