{
  "name": "@web-ide/python-graphics",
  "version": "0.1.0",
  "description": "Reusable browser Python 2D graphics companion for the web-ide component: a retained scene model, a bounded byte-device protocol with a multiplexer, an SVG renderer, and an optional Web IDE plugin.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "web-ide": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "web-ide": { "optional": true }
  },
  "keywords": [
    "web-ide",
    "python",
    "graphics",
    "education",
    "svg",
    "canvas"
  ]
}
